{
  "name": "specgraph",
  "version": "0.1.0",
  "description": "CLI tool that stores specs and business rules as a knowledge graph in LadybugDB, queryable via MCP for AI agents",
  "type": "module",
  "bin": {
    "specgraph": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ladybugdb/core": "^0.15.3",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
