{
  "name": "specgraph",
  "version": "0.1.0",
  "description": "CLI tool that stores specs and business rules as a knowledge graph in LadybugDB, queryable via MCP for AI agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "specgraph": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ladybugdb/core": "^0.15.3",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "gray-matter": "^4.0.3",
    "tree-sitter": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
