{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "shanpan rules > /dev/null 2>&1"
      }
    ],
    "postToolUse": [
      {
        "matcher": "Write",
        "command": "shanpan analyze > /dev/null 2>&1 && shanpan rules > /dev/null 2>&1"
      }
    ],
    "stop": [
      {
        "command": "shanpan check --hook-output --format cursor"
      }
    ]
  }
}