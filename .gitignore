node_modules/
dist/
*.js.map

# The graph is derived and disposable; the knowledge records are the source of
# truth and must be committed. Note the '/*' form — git cannot re-include a
# file whose parent directory is itself excluded.
.specgraph/*
!.specgraph/knowledge.ndjson
!.specgraph/knowledge.archive.ndjson

# Generated by `specgraph rules` from knowledge.ndjson — derived like graph.db.
# Hand-written rules (no specgraph- prefix) remain committable.
.cursor/rules/specgraph-*.mdc

# Generated by specgraph init/upgrade from src/opencode/specgraph-drift.plugin.ts
.opencode/plugin/specgraph-drift.ts

# Generated by specgraph init/upgrade from src/skills/index.ts. Every specgraph
# skill shares the "knowledge-" prefix, so this ignores the generated copies
# (which would otherwise fork the source of truth) while leaving hand-written
# skills — any other name — and settings.json / hooks.json committable, so a
# team can share the setup.
.claude/skills/knowledge-*/
.cursor/skills/knowledge-*/
.opencode/skills/knowledge-*/

# init writes this byte-identical to DEFAULT_CONFIG — nothing to track.
.specgraphrc.json
